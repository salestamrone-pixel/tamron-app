rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth.token.email;
    }
    function verified() {
      // The owner's account was created by the owner, so it is trusted even if e-mail verification never arrived.
      return request.auth != null && (request.auth.token.email_verified == true || request.auth.token.email == 'omarhussein271@gmail.com');
    }
    function staffPath() {
      return /databases/$(database)/documents/staff/$(email());
    }
    function isStaff() {
      return verified() && exists(staffPath()) && get(staffPath()).data.active == true;
    }
    // The company owner: always an administrator, can never be removed or demoted by anyone.
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'omarhussein271@gmail.com';
    }
    function isAdmin() {
      return isOwner() || (isStaff() && get(staffPath()).data.role == 'admin');
    }
    function isManager() {
      return isOwner() || (isStaff() && get(staffPath()).data.role in ['admin', 'hr']);
    }

    // Employee registry. Only admins change it; an employee can read their own entry.
    match /staff/{mail} {
      allow read: if isManager() || (verified() && email() == mail);
      allow create: if isAdmin();
      allow delete: if isAdmin() && mail != 'omarhussein271@gmail.com';
      // Only the owner may touch the owner's entry. HR may edit other profiles but never roles or activation.
      allow update: if isOwner() || (isAdmin() && mail != 'omarhussein271@gmail.com') || (isManager() && mail != 'omarhussein271@gmail.com'
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active);
    }

    // Customer quote requests.
    match /quoteRequests/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && !('reply' in request.resource.data);
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      // Admin may change anything (status, reply...). The owner may only edit their own
      // request's details, or cancel it, as long as the company hasn't replied yet.
      allow update: if isAdmin() || (
        request.auth != null && resource.data.userId == request.auth.uid
        && resource.data.status == 'new' && !('reply' in resource.data)
        && (
          (request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (request.resource.data.status == 'new'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['details', 'dimensions', 'quantity', 'location', 'phone', 'attachments']))
        )
      );
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());

      // A free-form thread on one request: the customer who owns it and any admin can
      // both read and post. Neither can edit or remove a message once sent.
      match /messages/{messageId} {
        function quote() {
          return get(/databases/$(database)/documents/quoteRequests/$(id));
        }
        allow read: if request.auth != null && (quote().data.userId == request.auth.uid || isAdmin());
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && (quote().data.userId == request.auth.uid || isAdmin());
      }
    }

    // One push token per signed-in user; only they can read or replace it.
    // Cloud Functions read/send through the Admin SDK, which bypasses these rules.
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Written once per login (any signed-in account, staff or customer) so the admin
    // dashboard can list who has used the app. A user may only ever touch their own doc.
    match /users/{uid} {
      allow read: if isManager() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // One shared counter doc, bumped on every app open (including signed-out visits).
    // Field-restricted and monotonic-only so an open write can't be used to inject or erase data.
    match /analytics/summary {
      allow read: if isManager();
      allow create: if request.resource.data.keys().hasOnly(['totalOpens', 'uniqueDevices']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalOpens', 'uniqueDevices'])
        && request.resource.data.totalOpens >= resource.data.totalOpens
        && request.resource.data.uniqueDevices >= resource.data.uniqueDevices;
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer-facing testimonials shown on the "about" page; admin-curated.
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin composes a message here; the Cloud Function that fans it out through
    // Expo push reads it with the Admin SDK, bypassing these rules.
    match /broadcasts/{id} {
      allow read, create: if isAdmin();
    }

    match /portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything below is invisible to customers.
    match /sites/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isManager() || (isStaff() && resource.data.email == email());
      allow create: if isStaff()
        && request.resource.data.email == email()
        && id == email() + '_' + request.resource.data.date;
      // An employee may only add their check-out; check-in fields stay as recorded.
      allow update: if isManager() || (isStaff()
        && resource.data.email == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOut', 'checkOutLoc']));
      allow delete: if isAdmin();
    }

    match /locations/{mail} {
      allow read: if isManager() || (isStaff() && email() == mail);
      allow write: if isStaff() && email() == mail;

      // Movement history: written by the employee's phone, read only by admins.
      match /points/{id} {
        allow read: if isAdmin();
        allow create: if isStaff() && email() == mail;
      }
    }

    // Leave and permission requests: staff file their own, only admins decide.
    match /hrRequests/{id} {
      allow create: if isStaff()
        && request.resource.data.email == email()
        && request.resource.data.status == 'pending';
      allow read: if isManager() || (isStaff() && resource.data.email == email());
      allow update: if isManager();
    }

    match /advances/{id} {
      allow read: if isManager() || (isStaff() && resource.data.email == email());
      allow create, delete: if isManager();
    }

    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /tasks/{id} {
      allow read: if isManager() || (isStaff() && resource.data.assigneeEmail == email());
      allow create, delete: if isManager();
      allow update: if isManager() || (isStaff()
        && resource.data.assigneeEmail == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedAt']));
    }

    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.by == email();
    }

    match /consents/{mail} {
      allow read: if isManager() || (isStaff() && email() == mail);
      allow write: if isStaff() && email() == mail;
    }
  }
}
