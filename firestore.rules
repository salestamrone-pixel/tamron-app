rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth.token.email;
    }
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function staffPath() {
      return /databases/$(database)/documents/staff/$(email());
    }
    function isStaff() {
      return verified() && exists(staffPath()) && get(staffPath()).data.active == true;
    }
    function isAdmin() {
      return isStaff() && get(staffPath()).data.role == 'admin';
    }

    // Employee registry. Only admins change it; an employee can read their own entry.
    match /staff/{mail} {
      allow read: if isAdmin() || (verified() && email() == mail);
      allow write: if isAdmin();
    }

    // Customer quote requests.
    match /quoteRequests/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && !('reply' in request.resource.data);
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything below is invisible to customers.
    match /sites/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.email == email());
      allow create: if isStaff()
        && request.resource.data.email == email()
        && id == email() + '_' + request.resource.data.date;
      // An employee may only add their check-out; check-in fields stay as recorded.
      allow update: if isAdmin() || (isStaff()
        && resource.data.email == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOut', 'checkOutLoc']));
      allow delete: if isAdmin();
    }

    match /locations/{mail} {
      allow read: if isAdmin() || (isStaff() && email() == mail);
      allow write: if isStaff() && email() == mail;

      // Movement history: written by the employee's phone, read only by admins.
      match /points/{id} {
        allow read: if isAdmin();
        allow create: if isStaff() && email() == mail;
      }
    }

    // Leave and permission requests: staff file their own, only admins decide.
    match /hrRequests/{id} {
      allow create: if isStaff()
        && request.resource.data.email == email()
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (isStaff() && resource.data.email == email());
      allow update: if isAdmin();
    }

    match /consents/{mail} {
      allow read: if isAdmin() || (isStaff() && email() == mail);
      allow write: if isStaff() && email() == mail;
    }
  }
}
