{
  "expo": {
    "name": "تامرون",
    "slug": "tamrone-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tamronapp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#000000",
    "description": "تطبيق شركة تامرون العربية المحدودة للدعاية والإعلان",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tamrone.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يستخدم تامرون موقعك لتسجيل حضور الموظفين تلقائياً ومتابعة الإدارة لمواقعهم، حتى عند إغلاق التطبيق.",
          "locationWhenInUsePermission": "يستخدم تامرون موقعك لتسجيل الحضور من موقع العمل.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#CCA741"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم تامرون صور معرضك لإرفاقها بطلب عرض السعر كمرجع للتصميم.",
          "cameraPermission": "يستخدم تامرون الكاميرا لتصوير موقع التركيب أو المرجع المطلوب وإرفاقه بطلب عرض السعر."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.tamrone.app",
      "supportsTablet": false
    },
    "owner": "tamrone-arabia-ltd",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08873681-277a-40ec-90b5-9f9443ffbaea"
      },
      "buildNumber": 11
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/08873681-277a-40ec-90b5-9f9443ffbaea"
    }
  }
}
