rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Reference images/files a customer attaches to a quote request. Not sensitive
    // (design refs, site photos), so any signed-in account may view one, but only
    // its owner may upload into their own folder.
    match /quoteAttachments/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Product photos uploaded from the admin "إدارة المتجر" screen. Public read, since
    // the store page itself is open to anyone; write stays scoped to the uploader's own
    // folder (only admins reach that screen client-side, same trust model as above).
    match /storeImages/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Work-sample photo attached when an admin marks a quote request "done" and adds
    // it to the public portfolio gallery.
    match /portfolioImages/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
